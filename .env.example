# Aegis Network Security Suite - Panel Configuration
# Microservice & Cluster Endpoints

# 1. Aegis Core API (GeoIP, Fastify Engine, ASN lookup)
AEGIS_API_URL=http://127.0.0.1:3000

# 2. Aegis-KernelFW (XDP/eBPF Daemon on VM 101)
KERNELFW_URL=http://172.30.0.101:8080

# 3. MikroTik RouterOS (CHR REST API on VM 102)
ROUTEROS_URL=http://192.168.100.1
ROUTEROS_USER=admin
ROUTEROS_PASS=

# 4. AdGuard Home DNS Controller (L3 DNS on VM 103)
ADGUARD_URL=http://192.168.100.2:80
ADGUARD_USER=admin
ADGUARD_PASS=

# 5. Panel Server Port
PORT=3001
NODE_ENV=production
